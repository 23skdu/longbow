      "id": 2,
      "title": "Nodes Added (Rate)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(longbow_hnsw_nodes_added_total[1m])) by (dataset)",
          "legendFormat": "{{dataset}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "title": "Bulk Insert Latency (p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(longbow_hnsw_bulk_insert_latency_by_type_seconds_bucket[5m])) by (le, type))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "title": "Ingestion Queue Depth",
      "type": "timeseries",
