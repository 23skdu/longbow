# Stage 1: Build with io_uring support
FROM golang:1.26.1-bookworm AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build with io_uring support
# -checklinkname=0 is required for iouring-go compatibility with Go 1.23+
RUN CGO_ENABLED=1 go build \
    -tags=linux,iouring \
    -ldflags="-s -w -checklinkname=0" \
    -o longbow ./cmd/longbow

# Stage 2: Minimal runtime
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/longbow /usr/local/bin/longbow

# Environment for io_uring
ENV LONGBOW_STORAGE_USE_IOURING=true
ENV LONGBOW_IOURING_QUEUE_DEPTH=256

EXPOSE 3000 3001 9090

ENTRYPOINT ["/usr/local/bin/longbow"]
