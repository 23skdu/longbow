      "targets": [{"expr": "sum(rate(graph_navigator_cache_hits_total[5m])) / (sum(rate(graph_navigator_cache_hits_total[5m])) + sum(rate(graph_navigator_cache_misses_total[5m])) + 1)", "refId": "A"}],
      "title": "Graph Navigation Cache Hit Rate",
      "type": "gauge"
