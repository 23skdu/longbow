      "datasource": "${datasource}",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "id": 6,
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(longbow_hnsw_search_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99", "refId": "A"}],
      "title": "HNSW Search Latency P99",
      "type": "timeseries"
