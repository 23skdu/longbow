        {
          "expr": "longbow_ingestion_lag_count",
          "legendFormat": "Lag",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "id": 6,
      "title": "Queue Latency (p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(longbow_ingestion_queue_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "Latency",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Construction cost of turboquant relative to float32 on the same dataset. Healthy is roughly 2.9x at 250k vectors, dim=128. Below 1.0 is not good news: it is the signature of the pre-a955a0c1 defect, where every turboquant candidate was rejected and the layer-0 graph was left partly disconnected. Cross-check against the Average Degree panel below.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.8
              },
              {
                "color": "yellow",
                "value": 4
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(longbow_hnsw_bulk_insert_latency_by_type_seconds_bucket{type=\"turboquant\"}[5m])) by (le)) / histogram_quantile(0.99, sum(rate(longbow_hnsw_bulk_insert_latency_by_type_seconds_bucket{type=\"float32\"}[5m])) by (le))",
          "legendFormat": "turboquant / float32",
          "refId": "A"
        }
      ],
      "title": "Bulk Insert Cost vs Float32 (ratio)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Mean layer-0 degree. A built graph sits close to its MMax0 budget: 15.7 measured at MMax0=16, ~31 at the chart default MMax0=64. The pre-a955a0c1 defect measured 6.92, with 27% of nodes unreachable at any ef. Values below 8 mean part of the corpus cannot be retrieved.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 8
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "longbow_hnsw_average_degree{level=\"0\"}",
          "legendFormat": "{{dataset}}",
          "refId": "A"
        }
      ],
      "title": "HNSW Layer-0 Average Degree",
      "type": "timeseries"
    },
    {
      "collapsed": false,
