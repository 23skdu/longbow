          "unit": "Bps"
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 20},
      "id": 15,
      "targets": [
        {"expr": "rate(longbow_flight_bytes_read_total[1m])", "legendFormat": "Read", "refId": "A"},
