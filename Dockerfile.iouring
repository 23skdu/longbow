# Dockerfile for io_uring testing and development
FROM golang:1.25-bookworm

WORKDIR /app

# Install tools for testing and debugging
RUN apt-get update && apt-get install -y --no-install-recommends \
    strace \
    htop \
    iotop \
    sysstat \
    linux-perf \
    && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN sed -i 's/^go 1.26.1/go 1.25/' go.mod && go mod download

COPY . .

# Ensure the patch persists after the full copy
RUN sed -i 's/^go 1.26.1/go 1.25/' go.mod

# Build with io_uring support
RUN CGO_ENABLED=1 go build \
    -tags=linux,iouring \
    -ldflags="-s -w" \
    -o longbow ./cmd/longbow

# Environment for io_uring
ENV LONGBOW_STORAGE_USE_IOURING=true
ENV LONGBOW_IOURING_QUEUE_DEPTH=256

EXPOSE 3000 3001 9090

ENTRYPOINT ["/app/longbow"]
