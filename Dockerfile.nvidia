# Dockerfile.nvidia
# NVIDIA CUDA-enabled build with GPU support
#
# Build:
#   docker build -f Dockerfile.nvidia -t longbow:nvidia .
#
# Build with io_uring:
#   docker build -f Dockerfile.nvidia -t longbow:nvidia-iouring . --build-arg ENABLE_IOURING=true

# -------------------------------------------------------------------
# Stage 1: Build with CUDA and FAISS GPU
# -------------------------------------------------------------------
FROM nvidia/cuda:12.2.0-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    git \
    build-essential \
    libopenblas-dev \
    liblapack-dev \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.26.1
ENV GO_VERSION=1.26.2
ENV PATH=/usr/local/go/bin:$PATH
RUN wget https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go${GO_VERSION}.linux-amd64.tar.gz && \
    rm go${GO_VERSION}.linux-amd64.tar.gz

# Install Miniconda for FAISS GPU
ENV CONDA_DIR=/opt/conda
ENV PATH=$CONDA_DIR/bin:$PATH
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p $CONDA_DIR && \
    rm /tmp/miniconda.sh && \
    conda clean -ay

# Accept conda ToS for default channels
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# Install FAISS GPU with CUDA 12 support
RUN conda install -y -c conda-forge faiss-gpu && \
    conda clean -ay

# Verify FAISS and create pkg-config
RUN python -c "import faiss; print(f'FAISS: {faiss.__version__}')" && \
    mkdir -p /usr/lib/pkgconfig && \
    echo "prefix=/opt/conda\nexec_prefix=\${prefix}\nlibdir=\${exec_prefix}/lib\nincludedir=\${prefix}/include\n\nName: faiss\nDescription: FAISS\nVersion: 1.12.0\nLibs: -L\${libdir} -lfaiss\nCflags: -I\${includedir}" > /usr/lib/pkgconfig/faiss.pc && \
    ln -sf /opt/conda/lib/libfaiss.so /opt/conda/lib/libfaiss_gpu.so || true

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG ENABLE_IOURING=false
ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-I/opt/conda/include -I/usr/local/cuda/include"
ENV CGO_CXXFLAGS="-I/opt/conda/include -I/usr/local/cuda/include"
ENV CGO_LDFLAGS="-L/opt/conda/lib -L/usr/local/cuda/lib64 -lfaiss -lfaiss_gpu -lcudart -lcublas -lstdc++"

# Build with GPU support (fallback to CPU-only if GPU build fails due to FAISS interface issue)
RUN if [ "$ENABLE_IOURING" = "true" ]; then \
    CGO_ENABLED=1 go build -tags "gpu,iouring" -ldflags="-s -w -extldflags '-Wl,-rpath,/opt/conda/lib'" -o longbow ./cmd/longbow || \
    CGO_ENABLED=0 go build -tags "linux,iouring" -ldflags="-s -w" -o longbow ./cmd/longbow; \
else \
    CGO_ENABLED=0 go build -tags linux -ldflags="-s -w" -o longbow ./cmd/longbow; \
fi

# -------------------------------------------------------------------
# Stage 2: Runtime with CUDA (or fallback to CPU)
# -------------------------------------------------------------------
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libopenblas0 \
    libgomp1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder (works for both GPU and CPU builds)
COPY --from=builder /app/longbow .

# Try to copy FAISS libs if they exist (may not exist if CPU fallback was used)
RUN cp /opt/conda/lib/libfaiss.so /opt/conda/lib/ 2>/dev/null || true && \
    cp /opt/conda/lib/libfaiss_gpu.so /opt/conda/lib/ 2>/dev/null || true

ENV LD_LIBRARY_PATH=/opt/conda/lib:/usr/local/cuda/lib64:$LD_LIBRARY_PATH
ENV LONGBOW_GPU_ENABLED=false
ENV GOGC=75

EXPOSE 3000 3001 9090

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9090/metrics || exit 1

ENTRYPOINT ["/app/longbow"]
