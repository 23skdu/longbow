      "datasource": "${datasource}",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 6},
      "id": 8,
      "targets": [
        {"expr": "rate(longbow_replication_success_total[1m])", "legendFormat": "Success/s", "refId": "A"},
