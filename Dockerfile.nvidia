# Dockerfile.nvidia
# NVIDIA CUDA-enabled build with GPU support
#
# Build:
#   docker build -f Dockerfile.nvidia -t longbow:nvidia .
#
# Build with io_uring:
#   docker build -f Dockerfile.nvidia -t longbow:nvidia-iouring . --build-arg ENABLE_IOURING=true

# -------------------------------------------------------------------
# Stage 1: Build with CUDA
# -------------------------------------------------------------------
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    git \
    build-essential \
    pkg-config \
    ca-certificates \
    libibverbs-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.26.2
ENV GO_VERSION=1.26.2
ENV PATH=/usr/local/go/bin:$PATH
RUN wget https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go${GO_VERSION}.linux-amd64.tar.gz && \
    rm go${GO_VERSION}.linux-amd64.tar.gz

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG ENABLE_IOURING=false
ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-I/usr/local/cuda/include"
ENV CGO_CXXFLAGS="-I/usr/local/cuda/include"
ENV CGO_LDFLAGS="-L/usr/local/cuda/lib64 -lcudart -lcublas -lstdc++"

# Build with GPU support
RUN if [ "$ENABLE_IOURING" = "true" ]; then \
    go build -tags "gpu,iouring" -ldflags="-s -w" -o longbow ./cmd/longbow; \
else \
    go build -tags "gpu" -ldflags="-s -w" -o longbow ./cmd/longbow; \
fi

# -------------------------------------------------------------------
# Stage 2: Runtime with CUDA
# -------------------------------------------------------------------
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libibverbs1 \
    ibverbs-providers \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /app/longbow .

ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
ENV LONGBOW_GPU_ENABLED=true
ENV GOGC=75

EXPOSE 3000 3001 9090

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9090/metrics || exit 1

ENTRYPOINT ["/app/longbow"]
