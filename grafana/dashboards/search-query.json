    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "panels": [],
      "title": "Flight Operations",
      "type": "row"
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["mean"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{"expr": "sum(longbow_flight_ops_total)", "refId": "A"}],
      "title": "Total Flight Ops",
      "type": "stat"
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line"},
          "unit": "ops"
        }
      },
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 1},
      "id": 3,
      "targets": [{"expr": "rate(longbow_flight_ops_total[1m])", "legendFormat": "{{action}}", "refId": "A"}],
      "title": "Flight Operations Rate",
      "type": "timeseries"
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line"},
          "unit": "s"
        }
      },
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 1},
      "id": 4,
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(longbow_flight_duration_seconds_bucket[5m])) by (le, action))", "legendFormat": "P99 {{action}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(longbow_flight_duration_seconds_bucket[5m])) by (le, action))", "legendFormat": "P95 {{action}}", "refId": "B"}
      ],
      "title": "Flight Latency P95/P99",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7},
