      "title": "Zero-Copy Ratio",
      "type": "timeseries"
    },
    {
      "datasource": "${datasource}",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 20},
      "id": 17,
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(longbow_doput_batch_size_bytes_bucket[5m])) by (le))", "legendFormat": "P99", "refId": "A"}],
      "title": "DoPut Payload Size P99",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26},
      "id": 18,
      "panels": [],
      "title": "Advanced Search Diagnostics",
