    {
      "datasource": "${datasource}",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 42},
      "id": 25,
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(longbow_geo_search_duration_seconds_bucket[5m])) by (le, search_type))", "legendFormat": "P99 {{search_type}}", "refId": "A"}],
      "title": "Geo Search Latency (P99)",
